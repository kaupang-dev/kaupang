{
  "services": {
    "postgres": {
      "image": "postgres:16-alpine",
      "ports": ["5432:5432"],
      "env": { "POSTGRES_USER": "app", "POSTGRES_PASSWORD": "app", "POSTGRES_DB": "app" },
      "healthcheck": { "test": ["CMD-SHELL", "pg_isready -U app"], "interval": "5s", "retries": 5 }
    },
    "redis": {
      "image": "redis:7-alpine",
      "ports": ["6379:6379"]
    }
  }
}
