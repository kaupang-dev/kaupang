{
  "name": "@kaupang/studio",
  "version": "0.3.3",
  "description": "kaupang studio — a small web UI to browse a catalog and assemble environments + solutions, then export a kaupang config. Launch with `kaupang studio` or run the Docker image.",
  "license": "MIT",
  "author": "Andreas Quist Batista",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaupang-dev/kaupang.git",
    "directory": "packages/studio"
  },
  "bugs": {
    "url": "https://github.com/kaupang-dev/kaupang/issues"
  },
  "homepage": "https://github.com/kaupang-dev/kaupang#readme",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "kaupang-studio": "./dist/serve.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run build:web && tsup",
    "build:web": "vite build web",
    "dev": "vite web",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@kaupang/core": "^0.3.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-virtual": "^3.14.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@xyflow/react": "^12.11.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.1",
    "vite": "^8.0.16",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "engines": {
    "node": ">=18"
  }
}
