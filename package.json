{
  "name": "kaupang-monorepo",
  "version": "0.1.2",
  "description": "Monorepo for kaupang — the trading hub for your deploys. Publishes @kaupang/core (engine + authoring API) and @kaupang/cli (the `kaupang` binary).",
  "license": "MIT",
  "author": "Andreas Quist Batista",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaupang-dev/kaupang.git"
  },
  "bugs": {
    "url": "https://github.com/kaupang-dev/kaupang/issues"
  },
  "homepage": "https://github.com/kaupang-dev/kaupang#readme",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @kaupang/core && npm run build -w @kaupang/cli",
    "typecheck": "npm run typecheck -w @kaupang/core && npm run typecheck -w @kaupang/cli",
    "test": "npm run test -w @kaupang/core",
    "coverage": "npm run coverage -w @kaupang/core",
    "dev": "jiti packages/cli/src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "4.1.8",
    "tsup": "8.3.5",
    "typescript": "5.7.3",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "airgap",
    "bundle",
    "cli",
    "compose",
    "deploy",
    "devops",
    "docker",
    "kubernetes",
    "oci",
    "swarm"
  ]
}
